@{
    ViewData["Title"] = "Home Page";
}

<h1>Art Gallery</h1>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Title</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var artPiece in Model)
        {
            <tr>
                <td>@artPiece.Id</td>
                <td>@artPiece.Title</td>
            </tr>
        }
    </tbody>
</table>
