@{
	ViewData["Title"] = "ArtPiece";
}

<h1>All art in the Gallery</h1>


@if (Model == null)
{
	<p>Все още няма добавени книги.</p>
}
else{
<table class="table">
	<thead>
		<tr>
			<th>Id</th>
			<th>Title</th>
			<th>Author </th>
		</tr>

	</thead>
	<tbody>
		@foreach (var artPiece in Model)
		{
			<tr>
				<td>@artPiece.Id</td>
				<td>@artPiece.Title</td>
				<td>@artPiece.Author.Id</td>
			</tr>
		}
	</tbody>

</table>

}
